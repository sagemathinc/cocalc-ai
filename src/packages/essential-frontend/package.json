{
  "name": "@cocalc/essential-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "The focused, low-overhead CoCalc web frontend",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": "./dist/app.js",
    "./app": "./dist/app.js",
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "copy-css": "mkdir -p dist && cp -v src/*.css dist/",
    "build": "pnpm run copy-css && pnpm exec tsc --build --force",
    "clean": "rm -rf dist node_modules tsconfig.tsbuildinfo",
    "test": "pnpm exec jest",
    "depcheck": "pnpm -w exec depcheck \"$PWD\" --ignores=@types/jest,@types/node,@types/prismjs,@types/react,@types/react-dom,@types/webpack-env,identity-obj-proxy,jest-environment-jsdom"
  },
  "dependencies": {
    "@cocalc/chat-client": "workspace:*",
    "@cocalc/conat": "workspace:*",
    "@cocalc/util": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "https://registry.npmjs.org/@cocalc/xterm/-/xterm-5.5.0-cocalc.5.tgz",
    "katex": "^0.16.21",
    "markdown-it": "^14.2.0",
    "prismjs": "^1.30.0",
    "react": "19.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.10",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "12.2.3",
    "@types/prismjs": "^1.26.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.1.7",
    "@types/webpack-env": "^1.18.8",
    "identity-obj-proxy": "^3.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "react-dom": "19.2.3",
    "ts-jest": "29.4.9"
  },
  "license": "SEE LICENSE.md"
}
