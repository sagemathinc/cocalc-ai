{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "dist",
    "lib": ["es2020"],
    "module": "commonjs",
    "target": "es2020",
    "paths": {
      "@cocalc/*": ["../node_modules/@cocalc/*"],
      "@cocalc/conat/*": ["../conat/dist/*"],
      "@cocalc/conat": ["../conat/dist/index"],
      "@cocalc/sync/*": ["../sync/dist/*"],
      "@cocalc/sync": ["../sync/dist/index"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "__tests__",
    "**/test/**",
    "**/__tests__/**",
    "**/__test__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.js",
    "**/*.test.jsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.spec.js",
    "**/*.spec.jsx",
    "jest.config.cjs"
  ],
  "references": [
    { "path": "../backend" },
    { "path": "../conat" },
    { "path": "../sync" },
    { "path": "../util" }
  ]
}
