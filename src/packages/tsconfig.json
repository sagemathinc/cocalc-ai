{
  "compilerOptions": {
    "allowJs": true,
    "composite": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["es2020", "dom"],
    "moduleResolution": "bundler",
    "paths": {
      "@cocalc/app-document-build": [
        "./node_modules/@cocalc/app-document-build/src"
      ],
      "@cocalc/app-document-build/*": [
        "./node_modules/@cocalc/app-document-build/src/*"
      ],
      "@cocalc/app-notebook": ["./node_modules/@cocalc/app-notebook/src"],
      "@cocalc/app-notebook/*": ["./node_modules/@cocalc/app-notebook/src/*"],
      "@cocalc/app-tasks": ["./node_modules/@cocalc/app-tasks/src"],
      "@cocalc/app-tasks/*": ["./node_modules/@cocalc/app-tasks/src/*"],
      "@cocalc/*": ["./node_modules/@cocalc/*"]
    },
    "noImplicitThis": true,
    "noUncheckedSideEffectImports": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": false,
    "strictNullChecks": true,
    "target": "es2020",
    "types": ["*"],
    "module": "commonjs"
  },
  "watchOptions": {
    "fallbackPolling": "dynamicPriority",
    "synchronousWatchDirectory": true,
    "watchDirectory": "useFsEvents",
    "watchFile": "useFsEvents"
  }
}
