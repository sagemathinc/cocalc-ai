{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["es7"],
    "rootDir": "./",
    "outDir": "dist"
  },
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/test/**",
    "**/__tests__/**",
    "**/__test__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.js",
    "**/*.test.jsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.spec.js",
    "**/*.spec.jsx",
    "jest.config.js",
    "fault-test",
    "dist-fault-test"
  ],
  "references": [{ "path": "../util", "path": "../conat", "path": "../sync" }]
}
