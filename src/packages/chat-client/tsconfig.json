{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist",
    "module": "commonjs",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "baseUrl": "."
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist",
    "node_modules",
    "src/__tests__/**",
    "**/*.test.ts",
    "**/*.spec.ts"
  ],
  "references": [
    { "path": "../chat" },
    { "path": "../conat" },
    { "path": "../util" }
  ]
}
