#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "${SCRIPT_DIR}/lib.sh"

# Restart cloudflared when its tunnel stops carrying traffic while the local
# origin is healthy. Crashes are handled by systemd (Restart=on-failure); this
# covers a process that stays up but is broken, e.g. one tunnel connection whose
# edge cancels every stream ("stream N canceled by remote") while the other
# connections keep working, so only a fraction of public requests hang.
#
# The tunnel runs as replicas (cocalc-bay-cloudflared.service is replica 1,
# cocalc-bay-cloudflared-N.service replica N), each with its own connections
# to Cloudflare. Each replica is judged on its own and only a degraded one is
# restarted, and never while no other replica is serving or soon after
# another replica was restarted, so public ingress never goes down.

: "${COCALC_BAY_CLOUDFLARED_WATCHDOG_ENABLED:=1}"
: "${COCALC_BAY_CLOUDFLARED_REPLICAS:=1 2}"
: "${COCALC_BAY_CLOUDFLARED_METRICS_URL:=http://127.0.0.1:20241}"
: "${COCALC_BAY_CLOUDFLARED_WATCHDOG_WINDOW_S:=60}"
: "${COCALC_BAY_CLOUDFLARED_WATCHDOG_MIN_FAILURES:=20}"
: "${COCALC_BAY_CLOUDFLARED_WATCHDOG_CONCENTRATION_PCT:=80}"
: "${COCALC_BAY_CLOUDFLARED_WATCHDOG_FAILURE_THRESHOLD:=3}"
: "${COCALC_BAY_CLOUDFLARED_WATCHDOG_RESTART_TIMEOUT_S:=60}"
: "${COCALC_BAY_CLOUDFLARED_WATCHDOG_RESTART_COOLDOWN_S:=900}"
: "${COCALC_BAY_CLOUDFLARED_WATCHDOG_READY_TIMEOUT_S:=30}"
# No replica is restarted within this long of another replica's restart.
: "${COCALC_BAY_CLOUDFLARED_WATCHDOG_REPLICA_GAP_S:=120}"

case "$COCALC_BAY_CLOUDFLARED_WATCHDOG_ENABLED" in
  0|false|no) exit 0 ;;
esac

: "${COCALC_BAY_CLOUDFLARED_CTL:=/usr/local/sbin/cocalc-bay-cloudflared-ctl}"
# The unit runs this as the bay user, with a systemd state directory; root
# privileges (the tunnel's journal, restarting it) go through the root-owned
# cloudflared-ctl.
STATE_DIR="${STATE_DIRECTORY:-${COCALC_BAY_RUN_DIR}/cloudflared-watchdog}"
mkdir -p "$STATE_DIR"
chmod 0700 "$STATE_DIR"
cloudflared_ctl=("$COCALC_BAY_CLOUDFLARED_CTL")
if [[ "$(id -u)" != 0 ]]; then
  cloudflared_ctl=(sudo -n "$COCALC_BAY_CLOUDFLARED_CTL")
fi

exec 9>"${STATE_DIR}/watchdog.lock"
if ! flock -n 9; then
  exit 0
fi

replica_unit() {
  if [[ "$1" == 1 ]]; then
    printf 'cocalc-bay-cloudflared.service\n'
  else
    printf 'cocalc-bay-cloudflared-%s.service\n' "$1"
  fi
}

replica_metrics_url() {
  if [[ "$1" == 1 ]]; then
    printf '%s\n' "$COCALC_BAY_CLOUDFLARED_METRICS_URL"
  else
    local var="COCALC_BAY_CLOUDFLARED_${1}_METRICS_URL"
    printf '%s\n' "${!var:-http://127.0.0.1:$((20240 + $1))}"
  fi
}

# Replica 1 uses the helper's original forms, which older helpers also know.
replica_ctl() {
  local replica="$1"
  shift
  if [[ "$replica" == 1 ]]; then
    "${cloudflared_ctl[@]}" "$@"
  else
    "${cloudflared_ctl[@]}" "$@" "$replica"
  fi
}

# Replica 1 keeps the state files at the top of the state directory.
replica_state_dir() {
  if [[ "$1" == 1 ]]; then
    printf '%s\n' "$STATE_DIR"
  else
    printf '%s/replica-%s\n' "$STATE_DIR" "$1"
  fi
}

ready_connections() {
  local url="$1" body
  if ! body="$(curl --silent --show-error \
      --max-time "${COCALC_BAY_HEALTH_TIMEOUT_S}" \
      "${url}/ready" 2>&1)"; then
    return 1
  fi
  python3 -c '
import json
import sys
try:
    value = json.load(sys.stdin)["readyConnections"]
except Exception:
    raise SystemExit(1)
if not isinstance(value, int) or value < 0:
    raise SystemExit(1)
print(value)
' <<<"$body"
}

# Why replica $1 must not be restarted now, if anything.
restart_blocked_by_other_replicas() {
  local replica="$1" now="$2" other last other_ready others_active=0
  for other in $COCALC_BAY_CLOUDFLARED_REPLICAS; do
    [[ "$other" == "$replica" ]] && continue
    last="$(cat "$(replica_state_dir "$other")/last-restart" 2>/dev/null || printf '0')"
    if [[ "$last" =~ ^[0-9]+$ ]] && \
        ((now - last < COCALC_BAY_CLOUDFLARED_WATCHDOG_REPLICA_GAP_S)); then
      printf 'replica %s was restarted %ss ago\n' "$other" "$((now - last))"
      return 0
    fi
    systemctl is-active --quiet "$(replica_unit "$other")" || continue
    others_active=1
    if other_ready="$(ready_connections "$(replica_metrics_url "$other")")" && \
        ((other_ready > 0)); then
      return 1
    fi
  done
  if ((others_active)); then
    printf 'no other replica has a ready tunnel connection\n'
    return 0
  fi
  # The only replica (or the others are disabled): restarting it is the only
  # way to recover.
  return 1
}

check_replica() {
  local replica="$1"
  local unit metrics_url state_dir failure_file restart_file last_seen_file
  unit="$(replica_unit "$replica")"
  metrics_url="$(replica_metrics_url "$replica")"
  state_dir="$(replica_state_dir "$replica")"
  mkdir -p "$state_dir"
  failure_file="${state_dir}/failures"
  restart_file="${state_dir}/last-restart"
  last_seen_file="${state_dir}/last-journal-timestamp"

  # An inactive unit is either intentionally disabled (direct Cloudflare-proxied
  # ingress, or a bay with fewer replicas) or crashed, which systemd restarts
  # on its own.
  if ! systemctl is-active --quiet "$unit"; then
    rm -f "$failure_file"
    return 0
  fi

  local ready
  if ! ready="$(ready_connections "$metrics_url")"; then
    bay_log "cloudflared watchdog could not read ${metrics_url}/ready (${unit})"
    return 0
  fi

  local now since active_since active_epoch last_seen
  now="$(date +%s)"
  since=$((now - COCALC_BAY_CLOUDFLARED_WATCHDOG_WINDOW_S))
  # Only count failures logged by the current process.
  active_since="$(systemctl show "$unit" --property=ActiveEnterTimestamp --value 2>/dev/null || true)"
  if [[ -n "$active_since" ]] && active_epoch="$(date -d "$active_since" +%s 2>/dev/null)" && \
      ((active_epoch > since)); then
    since="$active_epoch"
  fi
  # Each journal line counts toward at most one check: a strike needs new
  # failures, so one short burst cannot be re-read into several strikes.
  last_seen="$(cat "$last_seen_file" 2>/dev/null || printf '0')"
  if [[ ! "$last_seen" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    last_seen=0
  fi
  if ((${last_seen%.*} > since)); then
    since="${last_seen%.*}"
  fi

  # Output: "<total failures> <connIndex with most failures> <its failures>
  # <timestamp of the newest journal line read>".
  local total top_conn top_failures newest
  read -r total top_conn top_failures newest < <(
    replica_ctl "$replica" journal-since "$since" 2>/dev/null | \
      awk -v since="$since" -v last_seen="$last_seen" '
        BEGIN { after = since + 0; if (last_seen + 0 > after) after = last_seen + 0; newest = 0 }
        $1 ~ /^[0-9]+(\.[0-9]+)?$/ {
          t = $1 + 0
          if (t <= after) next
          if (t > newest) { newest = t; newest_text = $1 }
          if (/Request failed/ && match($0, /connIndex=[0-9]+/)) {
            conn = substr($0, RSTART + 10, RLENGTH - 10)
            count[conn]++
            total++
          }
        }
        END {
          top = "-"; best = 0
          for (conn in count) if (count[conn] > best) { best = count[conn]; top = conn }
          printf "%d %s %d %s\n", total, top, best, (newest > 0 ? newest_text : "-")
        }
      '
  )
  if [[ "$newest" != "-" ]]; then
    printf '%s\n' "$newest" > "$last_seen_file"
  fi

  local reason="" key=""
  # Strikes only accumulate while the same degradation persists; e.g. failures
  # dominated by a different connection in each check are not one bad edge.
  if ((ready == 0)); then
    reason="no ready tunnel connections"
    key="no-ready"
  elif ((ready >= 2 && \
      top_failures >= COCALC_BAY_CLOUDFLARED_WATCHDOG_MIN_FAILURES && \
      top_failures * 100 >= total * COCALC_BAY_CLOUDFLARED_WATCHDOG_CONCENTRATION_PCT)); then
    # Failures spread over every connection point at the origin or at clients;
    # a restart would not help. Failures pinned to one connection mean that
    # connection's edge path is broken.
    reason="tunnel connIndex=${top_conn} failed ${top_failures} of ${total} proxied requests since $(date -u -d "@${since}" +%H:%M:%SZ) (${ready} ready connections)"
    key="conn:${top_conn}"
  fi

  if [[ -z "$reason" ]]; then
    rm -f "$failure_file"
    return 0
  fi

  # Restarting the tunnel cannot fix a broken origin and would drop every
  # websocket, so leave origin failures to the hub watchdog and front door.
  if ! http_check "$(frontdoor_url)"; then
    rm -f "$failure_file"
    bay_log "cloudflared watchdog will not restart ${unit}: frontdoor is unhealthy (${reason})"
    return 0
  fi

  local last_restart
  last_restart="$(cat "$restart_file" 2>/dev/null || printf '0')"
  if [[ "$last_restart" =~ ^[0-9]+$ ]] && \
      ((now - last_restart < COCALC_BAY_CLOUDFLARED_WATCHDOG_RESTART_COOLDOWN_S)); then
    bay_log "cloudflared watchdog in restart cooldown for ${unit}: ${reason}"
    return 0
  fi

  local previous_key="" failures=0
  if [[ -f "$failure_file" ]]; then
    read -r previous_key failures < "$failure_file" || true
  fi
  if [[ "$previous_key" != "$key" || ! "$failures" =~ ^[0-9]+$ ]]; then
    failures=0
  fi
  failures=$((failures + 1))
  printf '%s %s\n' "$key" "$failures" > "$failure_file"
  if ((failures < COCALC_BAY_CLOUDFLARED_WATCHDOG_FAILURE_THRESHOLD)); then
    bay_log "cloudflared watchdog observed degraded tunnel on ${unit} (${failures}/${COCALC_BAY_CLOUDFLARED_WATCHDOG_FAILURE_THRESHOLD}): ${reason}"
    return 0
  fi

  local blocked
  if blocked="$(restart_blocked_by_other_replicas "$replica" "$now")"; then
    # Keep the strikes: restart as soon as another replica carries traffic.
    bay_log "cloudflared watchdog will not restart ${unit} yet (${blocked}): ${reason}"
    return 0
  fi

  local edges
  edges="$(curl --silent --max-time "${COCALC_BAY_HEALTH_TIMEOUT_S}" \
    "${metrics_url}/metrics" 2>/dev/null | \
    sed -n 's/^cloudflared_tunnel_server_locations{connection_id="\([0-9]*\)",edge_location="\([^"]*\)"}.*/\1=\2/p' | \
    tr '\n' ' ' || true)"
  bay_log "cloudflared watchdog restarting ${unit}: ${reason}; edges: ${edges:-unknown}"
  # Record the attempt before entering systemctl so a failed or hung restart
  # still respects the cooldown (and holds back the other replicas).
  printf '%s\n' "$now" > "$restart_file"
  local restart_args=(restart)
  [[ "$replica" == 1 ]] || restart_args+=("$replica")
  if ! timeout "${COCALC_BAY_CLOUDFLARED_WATCHDOG_RESTART_TIMEOUT_S}" \
      "${cloudflared_ctl[@]}" "${restart_args[@]}"; then
    bay_log "cloudflared watchdog failed to restart ${unit}"
    return 0
  fi
  rm -f "$failure_file"

  local deadline=$((SECONDS + COCALC_BAY_CLOUDFLARED_WATCHDOG_READY_TIMEOUT_S))
  while :; do
    if ready="$(ready_connections "$metrics_url")" && ((ready > 0)); then
      bay_log "cloudflared watchdog restarted ${unit}; ${ready} ready tunnel connections"
      return 0
    fi
    if ((SECONDS >= deadline)); then
      bay_log "cloudflared watchdog restarted ${unit} but no tunnel connection became ready within ${COCALC_BAY_CLOUDFLARED_WATCHDOG_READY_TIMEOUT_S}s"
      return 0
    fi
    sleep 1
  done
}

for replica in $COCALC_BAY_CLOUDFLARED_REPLICAS; do
  if [[ ! "$replica" =~ ^[1-9]$ ]]; then
    bay_log "cloudflared watchdog ignoring invalid replica: ${replica}"
    continue
  fi
  check_replica "$replica"
done
