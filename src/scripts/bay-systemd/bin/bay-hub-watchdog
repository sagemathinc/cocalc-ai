#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "${SCRIPT_DIR}/lib.sh"

: "${COCALC_BAY_HUB_WATCHDOG_FAILURE_THRESHOLD:=2}"
: "${COCALC_BAY_HUB_WATCHDOG_RESTART_TIMEOUT_S:=90}"
: "${COCALC_BAY_HUB_WATCHDOG_RESTART_COOLDOWN_S:=300}"
: "${COCALC_BAY_HUB_DIAGNOSTIC_TIMEOUT_S:=8}"
: "${COCALC_BAY_HUB_CTL:=/usr/local/sbin/cocalc-bay-hub-ctl}"

# The unit runs this as the bay user, with a systemd state directory; root
# privileges (restarting a hub worker) go through the root-owned hub-ctl.
STATE_DIR="${STATE_DIRECTORY:-${COCALC_BAY_RUN_DIR}/hub-watchdog}"
mkdir -p "$STATE_DIR"
chmod 0700 "$STATE_DIR"
hub_ctl=("$COCALC_BAY_HUB_CTL")
if [[ "$(id -u)" != 0 ]]; then
  hub_ctl=(sudo -n "$COCALC_BAY_HUB_CTL")
fi

exec 9>"${STATE_DIR}/watchdog.lock"
if ! flock -n 9; then
  exit 0
fi

if ! health_json="$({
  curl --silent --show-error \
    --max-time "${COCALC_BAY_HEALTH_TIMEOUT_S}" \
    "$(frontdoor_url)"
} 2>&1)"; then
  bay_log "hub watchdog could not query frontdoor: ${health_json}"
  exit 0
fi

if ! worker_rows="$(python3 -c '
import json
import sys

try:
    body = json.load(sys.stdin)
    workers = body["workers"]
except Exception as err:
    print(f"invalid frontdoor health response: {err}", file=sys.stderr)
    raise SystemExit(1)

for worker in workers:
    worker_id = worker.get("id")
    if not isinstance(worker_id, int) or worker_id < 1:
        continue
    healthy = 1 if worker.get("healthy") is True else 0
    drained = 1 if worker.get("drained") is True else 0
    print(f"{worker_id}\t{healthy}\t{drained}")
' <<<"$health_json")"; then
  bay_log "hub watchdog received invalid frontdoor health data"
  exit 0
fi

now="$(date +%s)"
while IFS=$'\t' read -r worker_id healthy drained; do
  [[ -n "$worker_id" ]] || continue
  failure_file="${STATE_DIR}/worker-${worker_id}.failures"
  restart_file="${STATE_DIR}/worker-${worker_id}.last-restart"
  unit="cocalc-bay-hub@${worker_id}.service"

  if [[ "$healthy" == "1" || "$drained" == "1" ]]; then
    rm -f "$failure_file"
    continue
  fi

  if ! systemctl is-enabled --quiet "$unit" && \
      ! systemctl is-active --quiet "$unit" && \
      ! systemctl is-failed --quiet "$unit"; then
    rm -f "$failure_file"
    continue
  fi

  active_state="$(systemctl show "$unit" --property=ActiveState --value 2>/dev/null || true)"
  sub_state="$(systemctl show "$unit" --property=SubState --value 2>/dev/null || true)"
  case "${active_state}/${sub_state}" in
    activating/*|deactivating/*|*/start*|*/stop*)
      bay_log "hub watchdog deferring transitional ${unit} (${active_state}/${sub_state})"
      continue
      ;;
  esac

  last_restart="$(cat "$restart_file" 2>/dev/null || printf '0')"
  if [[ "$last_restart" =~ ^[0-9]+$ ]] && \
      ((now - last_restart < COCALC_BAY_HUB_WATCHDOG_RESTART_COOLDOWN_S)); then
    continue
  fi

  failures="$(cat "$failure_file" 2>/dev/null || printf '0')"
  if [[ ! "$failures" =~ ^[0-9]+$ ]]; then
    failures=0
  fi
  failures=$((failures + 1))
  printf '%s\n' "$failures" > "$failure_file"
  if ((failures < COCALC_BAY_HUB_WATCHDOG_FAILURE_THRESHOLD)); then
    bay_log "hub watchdog observed unhealthy ${unit} (${failures}/${COCALC_BAY_HUB_WATCHDOG_FAILURE_THRESHOLD})"
    continue
  fi

  # A router outage makes every worker's deep readiness check fail. Restarting
  # hubs in that case would create a cluster-wide restart storm.
  if ! http_check "$(router_url)"; then
    bay_log "hub watchdog will not restart ${unit}: Conat router is unhealthy"
    exit 0
  fi

  bay_log "hub watchdog restarting persistently unhealthy ${unit} (${active_state}/${sub_state})"
  if diagnostic_path="$(
    printf '%s\n' "$health_json" | \
      timeout "${COCALC_BAY_HUB_DIAGNOSTIC_TIMEOUT_S}" \
        "${COCALC_BAY_CURRENT_LINK}/bin/bay-hub-diagnose" "$worker_id"
  )"; then
    bay_log "hub watchdog captured diagnostics for ${unit}: ${diagnostic_path}"
  else
    bay_log "hub watchdog could not capture diagnostics for ${unit}"
  fi
  "${COCALC_BAY_CURRENT_LINK}/bin/bay-frontdoor-drain" "$worker_id"
  # Record the attempt before entering systemctl. A failed or timed-out restart
  # must also respect the cooldown instead of retrying every timer tick.
  printf '%s\n' "$now" > "$restart_file"
  if timeout "${COCALC_BAY_HUB_WATCHDOG_RESTART_TIMEOUT_S}" \
      "${hub_ctl[@]}" restart "$worker_id" && \
      "${COCALC_BAY_CURRENT_LINK}/bin/bay-worker-health" "$worker_id"; then
    rm -f "$failure_file"
    "${COCALC_BAY_CURRENT_LINK}/bin/bay-frontdoor-undrain" "$worker_id"
    bay_log "hub watchdog restarted ${unit}"
  else
    "${COCALC_BAY_CURRENT_LINK}/bin/bay-frontdoor-undrain" "$worker_id" || true
    bay_log "hub watchdog failed to restart ${unit}"
  fi

  # Never restart more than one worker in a single timer invocation.
  exit 0
done <<<"$worker_rows"
