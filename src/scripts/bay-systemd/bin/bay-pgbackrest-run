#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "${SCRIPT_DIR}/lib.sh"
# shellcheck source=pgbackrest-lib.sh
source "${SCRIPT_DIR}/pgbackrest-lib.sh"

if [[ "${COCALC_BAY_PGBACKREST_ENABLED:-0}" != "1" ]]; then
  bay_log "pgBackRest is disabled"
  exit 0
fi

action="${1:-}"
pgbackrest_set_defaults
pgbackrest_export_secrets
"${SCRIPT_DIR}/bay-pgbackrest-configure"
if [[ ! -x "$COCALC_BAY_PGBACKREST_BIN" ]]; then
  bay_log "pgBackRest binary is not executable: ${COCALC_BAY_PGBACKREST_BIN}"
  exit 1
fi
stanza="$(pgbackrest_stanza)"
common=(
  "$COCALC_BAY_PGBACKREST_BIN"
  "--config=$COCALC_BAY_PGBACKREST_CONFIG"
  "--stanza=$stanza"
  "--log-level-console=info"
)

case "$action" in
  stanza-create)
    exec "${common[@]}" stanza-create
    ;;
  setup)
    # stanza-create takes the archive and backup locks without waiting, and the
    # async archive-push process holds the archive lock while it pushes WAL. Every
    # backup@ pulls this unit in, so retry only on LockAcquireError [050]. The
    # defaults keep the worst case (11 sleeps of 15 s, the creates, then check
    # waiting up to archive-timeout=300s) inside the unit's 10 min timeout.
    attempts="${COCALC_BAY_PGBACKREST_SETUP_LOCK_ATTEMPTS:-12}"
    delay="${COCALC_BAY_PGBACKREST_SETUP_LOCK_DELAY_S:-15}"
    if [[ ! "$attempts" =~ ^[1-9][0-9]*$ || ! "$delay" =~ ^[0-9]+$ ]]; then
      bay_log "invalid setup lock retry settings: attempts=${attempts} delay=${delay}"
      exit 2
    fi
    attempt=1
    while true; do
      rc=0
      "${common[@]}" stanza-create || rc=$?
      [[ "$rc" == 0 ]] && break
      if [[ "$rc" != 50 ]] || ((attempt >= attempts)); then
        exit "$rc"
      fi
      bay_log "stanza-create could not take its lock (attempt ${attempt}/${attempts}); retrying in ${delay}s"
      sleep "$delay"
      attempt=$((attempt + 1))
    done
    exec "${common[@]}" check
    ;;
  full|diff|incr)
    exec "${common[@]}" "--type=$action" backup
    ;;
  check|expire|info|verify)
    exec "${common[@]}" "$action"
    ;;
  *)
    bay_log "usage: bay-pgbackrest-run stanza-create|setup|full|diff|incr|check|expire|info|verify"
    exit 2
    ;;
esac
