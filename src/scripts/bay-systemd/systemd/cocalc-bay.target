[Unit]
Description=CoCalc Bay Aggregate Target
Wants=cocalc-bay-postgres.service
Wants=cocalc-bay-conat-persist.service
Wants=cocalc-bay-conat-router.service
Wants=cocalc-bay-peer-health.service
Wants=cocalc-bay-hub-workers.target
Wants=cocalc-bay-billing.service
Wants=cocalc-bay-hub-watchdog.timer
Wants=cocalc-bay-cloudflared-watchdog.timer
After=network-online.target

[Install]
WantedBy=multi-user.target
