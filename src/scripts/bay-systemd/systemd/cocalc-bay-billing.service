[Unit]
Description=CoCalc singleton billing executor (seed bay only)
After=cocalc-bay-postgres.service cocalc-bay-migrations.service cocalc-bay-conat-router.service
Requires=cocalc-bay-postgres.service cocalc-bay-conat-router.service
PartOf=cocalc-bay.target

[Service]
Type=exec
User=cocalc-bay
WorkingDirectory=/opt/cocalc/bay/current
EnvironmentFile=/etc/cocalc/bay.env
EnvironmentFile=-/etc/cocalc/bay-overlay.env
EnvironmentFile=-/etc/cocalc/bay-topology.env
EnvironmentFile=-/etc/cocalc/bay-secrets.env
EnvironmentFile=-/etc/cocalc/bay-local.env
Environment=COCALC_REQUIRE_SITE_MASTER_KEY=1
LoadCredential=site-master-key:/etc/cocalc/site-master-key
ExecStart=/opt/cocalc/bay/current/bin/bay-billing-worker
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=cocalc-bay.target
