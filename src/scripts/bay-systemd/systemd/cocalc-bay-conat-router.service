[Unit]
Description=CoCalc Bay Conat Router
After=cocalc-bay-postgres.service cocalc-bay-migrations.service
Requires=cocalc-bay-postgres.service cocalc-bay-migrations.service
PartOf=cocalc-bay.target

[Service]
Type=exec
User=cocalc-bay
WorkingDirectory=/opt/cocalc/bay/current
EnvironmentFile=/etc/cocalc/bay.env
EnvironmentFile=-/etc/cocalc/bay-workers.env
EnvironmentFile=-/etc/cocalc/bay-overlay.env
EnvironmentFile=-/etc/cocalc/bay-topology.env
EnvironmentFile=-/etc/cocalc/bay-secrets.env
EnvironmentFile=-/etc/cocalc/bay-local.env
Environment=COCALC_REQUIRE_SITE_MASTER_KEY=1
LoadCredential=site-master-key:/etc/cocalc/site-master-key
LoadCredential=site-master-key.keyring:/etc/cocalc/site-master-key.keyring
ExecStartPre=/opt/cocalc/bay/current/bin/bay-preflight router
ExecStart=/opt/cocalc/bay/current/bin/bay-conat-router
ExecStartPost=/opt/cocalc/bay/current/bin/bay-health --router-only
Restart=always
RestartSec=2
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=cocalc-bay.target
