# Copy to /etc/cocalc/bay.env and replace placeholders.

COCALC_BAY_ID=bay-1
COCALC_BAY_ROOT=/mnt/cocalc/bays/bay-1

COCALC_BAY_RELEASES_DIR=/opt/cocalc/bay/releases
COCALC_BAY_CURRENT_LINK=/opt/cocalc/bay/current
COCALC_BAY_NODE_VERSION=26.2.0
COCALC_BAY_NODE_BIN=/opt/cocalc/nvm/versions/node/v26.2.0/bin/node

COCALC_BAY_STATE_DIR=/mnt/cocalc/bays/bay-1/state
COCALC_BAY_RUN_DIR=/mnt/cocalc/bays/bay-1/run
COCALC_BAY_LOG_DIR=/mnt/cocalc/bays/bay-1/logs
# Production should override this with a dedicated mounted filesystem and set
# COCALC_BAY_BACKUP_REQUIRE_SEPARATE_FILESYSTEM=1.
COCALC_BACKUP_ROOT=/mnt/cocalc/bays/bay-1/backups
# Compatibility alias. Backup scripts treat COCALC_BACKUP_ROOT as canonical.
COCALC_BAY_BACKUP_DIR=/mnt/cocalc/bays/bay-1/backups
COCALC_BAY_BACKUP_REQUIRE_SEPARATE_FILESYSTEM=0
COCALC_BAY_BACKUP_MIN_FREE_BYTES=68719476736
COCALC_BAY_BACKUP_RETRY_MAX_MS=21600000
COCALC_BIN_PATH=/mnt/cocalc/bays/bay-1/bin

# pgBackRest is opt-in. Configure its R2 credentials in bay-secrets.env, create
# the stanza while PostgreSQL still serves, then restart PostgreSQL once and run
# cocalc-bay-pgbackrest-setup.service before enabling backup timers.
COCALC_BAY_PGBACKREST_ENABLED=0
COCALC_BAY_PGBACKREST_BIN=/usr/local/bin/pgbackrest
COCALC_BAY_PGBACKREST_CONFIG=${COCALC_BACKUP_ROOT}/pgbackrest/pgbackrest.conf
COCALC_BAY_PGBACKREST_SPOOL_PATH=${COCALC_BACKUP_ROOT}/pgbackrest/spool
COCALC_BAY_PGBACKREST_LOCK_PATH=/mnt/cocalc/bays/bay-1/run/pgbackrest
COCALC_BAY_PGBACKREST_LOG_PATH=/mnt/cocalc/bays/bay-1/logs/pgbackrest
COCALC_BAY_PGBACKREST_REPO_PATH=/pgbackrest/bay-1
COCALC_BAY_PGBACKREST_PROCESS_MAX=1
COCALC_BAY_PGBACKREST_RETENTION_FULL=2
COCALC_BAY_PGBACKREST_RETENTION_DIFF=14
COCALC_BAY_PGBACKREST_STATUS_FILE=/mnt/cocalc/bays/bay-1/state/pgbackrest-status.json
COCALC_BAY_PGBACKREST_RESTORE_STATUS_FILE=/mnt/cocalc/bays/bay-1/state/pgbackrest-restore-test-status.json
COCALC_BAY_PGBACKREST_MAX_BACKUP_AGE_S=129600
COCALC_BAY_PGBACKREST_MAX_SPOOL_AGE_S=600
COCALC_BAY_PGBACKREST_MAX_WAL_BACKLOG_BYTES=8589934592

# SQLite persistence is mirrored with SQLite's online backup API only when a
# DB/WAL/SHM signature changes, then the uncompressed mirror is deduplicated by
# Rustic. This is independent of PostgreSQL pgBackRest backups.
COCALC_BAY_SQLITE_BACKUP_ENABLED=0
COCALC_BAY_SQLITE_SOURCE_DIR=/mnt/cocalc/bays/bay-1/sync
COCALC_BAY_SQLITE_MIRROR_DIR=${COCALC_BACKUP_ROOT}/sqlite-mirror/sync
COCALC_BAY_SQLITE_MIRROR_CATALOG=${COCALC_BACKUP_ROOT}/sqlite-mirror/catalog.json
COCALC_BAY_SQLITE_MIRROR_ENTRY=/opt/cocalc/bay/current/runtime/sqlite-mirror/index.js
COCALC_BAY_SQLITE_MIRROR_CONCURRENCY=2
COCALC_BAY_SQLITE_RUSTIC_BIN=/usr/local/bin/rustic
COCALC_BAY_SQLITE_RUSTIC_PROFILE=${COCALC_BACKUP_ROOT}/sqlite-mirror/rustic.toml
COCALC_BAY_SQLITE_RUSTIC_ROOT=rustic/bay-sqlite/bay-1
COCALC_BAY_SQLITE_BACKUP_STATUS_FILE=/mnt/cocalc/bays/bay-1/state/sqlite-backup-status.json
COCALC_BAY_SQLITE_RETENTION_HOURLY=24
COCALC_BAY_SQLITE_RETENTION_DAILY=14
COCALC_BAY_SQLITE_RETENTION_WEEKLY=8
COCALC_BAY_SQLITE_RETENTION_MONTHLY=12

COCALC_BAY_POSTGRES_HOST=127.0.0.1
COCALC_BAY_POSTGRES_PORT=5432
COCALC_BAY_POSTGRES_DATA_DIR=/mnt/cocalc/bays/bay-1/postgres
COCALC_BAY_POSTGRES_DB=cocalc_bay
COCALC_BAY_POSTGRES_USER=cocalc
COCALC_BAY_POSTGRES_MAX_WAL_SIZE=8GB
COCALC_BAY_POSTGRES_SHARED_BUFFERS=1GB
COCALC_BAY_POSTGRES_EFFECTIVE_CACHE_SIZE=8GB
COCALC_BAY_POSTGRES_SOCKET_DIR=/mnt/cocalc/bays/bay-1/run/postgres

COCALC_BAY_PERSIST_HOST=127.0.0.1
COCALC_BAY_PERSIST_PORT=9202
COCALC_BAY_PERSIST_HEALTH_PATH=/healthz
COCALC_PERSIST_MAINTENANCE_ENABLED=1
COCALC_PERSIST_MAINTENANCE_DRY_RUN=1

COCALC_BAY_ROUTER_HOST=127.0.0.1
COCALC_BAY_ROUTER_PORT=9102
COCALC_BAY_ROUTER_HEALTH_PATH=/healthz

COCALC_BAY_HUB_BIND_HOST=127.0.0.1
COCALC_BAY_HUB_BASE_PORT=9300
COCALC_BAY_HUB_HEALTH_PATH=/ready
# First-party analytics remains off unless an operator has configured consent.
COCALC_ENABLE_ANALYTICS=0

COCALC_BAY_FRONTDOOR_HOST=127.0.0.1
COCALC_BAY_FRONTDOOR_PORT=9400
COCALC_BAY_FRONTDOOR_HEALTH_PATH=/_cocalc/frontdoor/healthz
COCALC_BAY_FRONTDOOR_DRAIN_FILE=/mnt/cocalc/bays/bay-1/state/frontdoor-drain-workers
COCALC_BAY_FRONTDOOR_UNHEALTHY_THRESHOLD=3
COCALC_BAY_FRONTDOOR_HEALTH_ERROR_MAX_BYTES=2048
# Frontdoor-generated application probe. A worker that keeps failing it while
# a strict majority of its ready peers pass is removed from routing, its
# websockets are evicted, and the hub watchdog restarts it. Use "off" to disable.
COCALC_BAY_FRONTDOOR_APP_PROBE_PATH=/customize
COCALC_BAY_FRONTDOOR_APP_PROBE_INTERVAL_MS=5000
COCALC_BAY_FRONTDOOR_APP_PROBE_TIMEOUT_MS=5000
COCALC_BAY_FRONTDOOR_APP_PROBE_UNHEALTHY_THRESHOLD=3
# Keep the default tunnel unless a separately provisioned direct origin is
# ready. cloudflare-proxy disables bay cloudflared and trusts Cloudflare client
# headers only after the direct ingress has restricted its frontend to
# Cloudflare source ranges.
COCALC_BAY_PUBLIC_INGRESS_MODE=cloudflare-tunnel
# Optional transition override. Set this to 1 only while retaining a
# restartable tunnel during a direct-ingress cutover; remove it afterward.
# COCALC_BAY_CLOUDFLARED_ENABLED=1

COCALC_BAY_HUB_WATCHDOG_FAILURE_THRESHOLD=2
COCALC_BAY_HUB_WATCHDOG_RESTART_TIMEOUT_S=90
COCALC_BAY_HUB_WATCHDOG_RESTART_COOLDOWN_S=300
COCALC_BAY_HUB_DIAGNOSTIC_TIMEOUT_S=8
COCALC_BAY_HUB_DIAGNOSTIC_DIR=/var/log/cocalc-bay/hub-watchdog-incidents
COCALC_BAY_HUB_DIAGNOSTIC_RETENTION_DAYS=14
COCALC_BAY_HUB_DIAGNOSTIC_MAX_FILES=100

# Bay service logging (set on every release; override DEBUG in bay-local.env).
# Without DEBUG the logger writes nothing. Without DEBUG_FILE= it would also
# append to an unrotated $LOGS/log, because bay services do not set
# NODE_ENV=production. Console output goes to the capped journald.
DEBUG=cocalc:error:*,cocalc:warn:*
DEBUG_CONSOLE=yes
DEBUG_FILE=

COCALC_BAY_MIN_HEALTHY_WORKERS=2
COCALC_BAY_HEALTH_TIMEOUT_S=15
COCALC_BAY_WORKER_START_TIMEOUT_S=90
COCALC_BAY_MIN_FREE_MB=1024
COCALC_BAY_CLOUDFLARED_SYSTEMD=1

# Replace these with the real bundle entrypoints.
COCALC_BAY_POSTGRES_CMD='/usr/lib/postgresql/16/bin/postgres -D "$COCALC_BAY_POSTGRES_DATA_DIR" -p "$COCALC_BAY_POSTGRES_PORT" -c max_wal_size="$COCALC_BAY_POSTGRES_MAX_WAL_SIZE" -c shared_buffers="$COCALC_BAY_POSTGRES_SHARED_BUFFERS" -c effective_cache_size="$COCALC_BAY_POSTGRES_EFFECTIVE_CACHE_SIZE"'
COCALC_BAY_MIGRATE_CMD='/opt/cocalc/bay/current/libexec/bay-migrate-real'
COCALC_BAY_PERSIST_CMD='/opt/cocalc/bay/current/libexec/bay-conat-persist-real'
COCALC_BAY_ROUTER_CMD='/opt/cocalc/bay/current/libexec/bay-conat-router-real'
COCALC_BAY_HUB_CMD='/opt/cocalc/bay/current/libexec/bay-hub-real'
